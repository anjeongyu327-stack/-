	registerTitle("전직자", "아무 직업으로나 전직하세요", "일반")
	registerTitle("검의 길", "검사(동양) 또는 검사(서양)로 전직하세요", "일반")
	registerTitle("마나의 흐름", "마법사로 전직하세요", "일반")
