########################################################################
# 06_stats.sk — 스탯포인트 시스템 (힘/민첩/체력/행운/회피) + 크리티컬/회피 전투 판정
#
# 필요 애드온: 없음
#
# 사용 변수:
#   {stats::%player%::str} / ::agi / ::vit / ::luck / ::eva  - 투자 포인트
#   {stats::%player%::statpoints}       - 잔여 포인트
#   {stats::%player%::statpointsspent}  - 누적 소모 포인트 (칭호용)
#   {stats::%player%::lastalloc::%stat%::time}  - 마지막 투자 시각(5분 이내 재분배 가능)
#   {stats::%player%::evasioncount}     - 회피로 흘려낸 치명타 횟수 (titles.sk 연동)
#
# 효과:
#   힘 1당 공격력 +0.15 (근접 피해에 가산)
#   민첩 1당 이동속도 +5%p (비복리 가산식 — 폭주 방지를 위해 곱연산 대신 가산 후 배율 상한 3.0x)
#   체력 1당 최대체력 +0.5칸(=1 health point)
#   행운 1당 크리티컬 확률 +0.1% (크리티컬시 피해 2배)
#   회피 1당 회피율 +0.1% (피격을 완전히 무효화)
#
# 훅 / 의존관계:
#   - 00_core.sk 의 on join / on respawn 이 applyStatEffects() 호출
#   - gui.sk 의 메인 GUI에서 openStatGUI() 를 호출해 스탯 GUI 진입
#   - on damage 이벤트에서 힘 피해 가산 + 크리티컬/회피 판정 처리 (PvE, PvP 공통)
#   - titles.sk 의 checkStatInvestTitles / checkCritKillTitle / checkEvasionTitle 호출
########################################################################

function applyStatEffects(p: player):
	set {_vit} = {stats::%{_p}%::vit} ? 0
	set the max health of {_p} to (20 + {_vit})
	set {_agi} = {stats::%{_p}%::agi} ? 0
	set {_mult} = 1 + ({_agi} * 0.05)
	if {_mult} > 3.0:
		set {_mult} = 3.0
	set the walk speed of {_p} to (0.2 * {_mult})

function getStrengthBonus(p: player) :: number:
	return (({stats::%{_p}%::str} ? 0) * 0.15)

function getCritChance(p: player) :: number:
	return (({stats::%{_p}%::luck} ? 0) * 0.001)

function getEvasionChance(p: player) :: number:
	return (({stats::%{_p}%::eva} ? 0) * 0.001)

# ------------------------------------------------------------------
# 전투 판정: 힘 피해가산 -> 회피(피해자) -> 크리티컬(공격자) 순서로 적용
# ------------------------------------------------------------------
on damage:
	if attacker is a player:
		set {_dmg} = damage
		set {_dmg} = {_dmg} + getStrengthBonus(attacker)
		set {_iscrit} = false
		if random number between 0.0 and 1.0 <= getCritChance(attacker):
			set {_dmg} = {_dmg} * 2
			set {_iscrit} = true
			send action bar "<gold><bold>치명타!" to attacker
		set damage to {_dmg}
		set {lastcrit::%attacker%} to {_iscrit}
	if victim is a player:
		if random number between 0.0 and 1.0 <= getEvasionChance(victim):
			set damage to 0
			send action bar "<aqua>회피!" to victim
			if attacker is a player:
				checkEvasionTitle(victim)
			else:
				add 1 to {stats::%victim%::evasioncount}
				if {stats::%victim%::evasioncount} >= 10:
					grantTitle(victim, "종이 한 장 차이")

# ------------------------------------------------------------------
# 스탯 GUI
# ------------------------------------------------------------------
function openStatGUI(p: player):
	open chest inventory with size 27 named "<dark_aqua>스탯 분배" to {_p}
	set {_pts} = {stats::%{_p}%::statpoints} ? 0
	set {_str} = {stats::%{_p}%::str} ? 0
	set {_agi} = {stats::%{_p}%::agi} ? 0
	set {_vit} = {stats::%{_p}%::vit} ? 0
	set {_luck} = {stats::%{_p}%::luck} ? 0
	set {_eva} = {stats::%{_p}%::eva} ? 0
	set slot 4 of {_p}'s current inventory to nether star named "<yellow>잔여 포인트: %{_pts}%" with lore "<gray>좌클릭 +1 / 쉬프트+좌클릭 +10" and "<gray>우클릭 -1 (최근 5분 이내 투자분만 환불)"
	set slot 10 of {_p}'s current inventory to iron sword named "<red>힘: %{_str}%" with lore "<gray>공격력 +0.15 / 1포인트"
	set slot 11 of {_p}'s current inventory to feather named "<green>민첩: %{_agi}%" with lore "<gray>이동속도 +5%% / 1포인트 (최대 300%%)"
	set slot 13 of {_p}'s current inventory to golden apple named "<light_purple>체력: %{_vit}%" with lore "<gray>최대체력 +0.5칸 / 1포인트"
	set slot 15 of {_p}'s current inventory to gold nugget named "<gold>행운: %{_luck}%" with lore "<gray>크리티컬 확률 +0.1%% / 1포인트"
	set slot 16 of {_p}'s current inventory to phantom membrane named "<aqua>회피: %{_eva}%" with lore "<gray>회피율 +0.1%% / 1포인트"

function statSlotName(slot: number) :: text:
	if {_slot} is 10:
		return "str"
	else if {_slot} is 11:
		return "agi"
	else if {_slot} is 13:
		return "vit"
	else if {_slot} is 15:
		return "luck"
	else if {_slot} is 16:
		return "eva"
	return ""

function grantStatPoint(p: player, stat: text, amount: number):
	set {_have} = {stats::%{_p}%::statpoints} ? 0
	if {_have} < {_amount}:
		set {_amount} = {_have}
	if {_amount} <= 0:
		stop
	add {_amount} to {stats::%{_p}%::%{_stat}%}
	subtract {_amount} from {stats::%{_p}%::statpoints}
	add {_amount} to {stats::%{_p}%::statpointsspent}
	set {stats::%{_p}%::lastalloc::%{_stat}%::time} to now
	applyStatEffects({_p})
	checkStatInvestTitles({_p})

function refundStatPoint(p: player, stat: text):
	if {stats::%{_p}%::%{_stat}%} ? 0 <= 0:
		stop
	set {_t} = {stats::%{_p}%::lastalloc::%{_stat}%::time}
	if {_t} is not set:
		send "<red>최근 5분 이내에 투자한 포인트만 환불할 수 있습니다." to {_p}
		stop
	if difference between now and {_t} > 5 minutes:
		send "<red>재분배 가능 시간(5분)이 지났습니다." to {_p}
		stop
	subtract 1 from {stats::%{_p}%::%{_stat}%}
	add 1 to {stats::%{_p}%::statpoints}
	subtract 1 from {stats::%{_p}%::statpointsspent}
	applyStatEffects({_p})

on inventory click:
	if name of event-inventory is "<dark_aqua>스탯 분배":
		cancel event
		set {_p} = player
		set {_stat} = statSlotName(raw slot)
		if {_stat} is "":
			stop
		if click type is left click:
			grantStatPoint({_p}, {_stat}, 1)
		else if click type is shift left click:
			grantStatPoint({_p}, {_stat}, 10)
		else if click type is right click:
			refundStatPoint({_p}, {_stat})
		openStatGUI({_p})

command /스탯:
	trigger:
		openStatGUI(player)
