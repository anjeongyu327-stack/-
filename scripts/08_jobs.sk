########################################################################
# 08_jobs.sk — 직업 시스템
# 주의: 프롬프트 본문의 [직업 종류] 목록은 실제로 13종(일반 8종 + 히든 5종)이 채워져 있음.
#       최종 요청 문구의 "직업 14종"은 원문 데이터 개수와 불일치하여, 실제 제공된 13종 그대로 구현함.
#
# 필요 애드온: 없음
#
# 사용 변수:
#   {jobdata::hidden::%job%}         - 히든 직업 여부 (true/false)
#   {jobdata::type::%job%}           - 직업 유형(전투/원거리 등, 안내용)
#   {jobtooldata::%job%}             - 전용 아이템 이름 ("" = 없음)
#   {jobdata::skills::%job%::*}      - 스킬 이름 목록 (습득순)
#   {jobdata::skillreq::%skillname%} - 스킬 습득 레벨
#   {jobdata::skillowner::%skillname%} - 해당 스킬이 속한 직업
#   {jobdata::skillpassive::%skillname%} - 패시브(&) 여부
#   {joblocation::%job%::*}          - /전직장소 로 등록된 좌표 (world,x,y,z)
#   {server::hiddenjob::%job%}       - 히든 직업 보유자 (서버 전체 1명)
#   {server::anyhiddenjobclaimed}    - 서버 최초 히든직업 획득 여부 (유일무이 칭호)
#   {stats::%player%::job}           - 현재 직업
#   {jobchange::%player%::progress}/{::target} - 전직 진행 상태(5초 웅크림)
#
# 훅 / 의존관계:
#   - 03_biomes.sk 의 /전직장소 명령이 registerJobLocation() 을 호출
#   - every 1 second 로 웅크림 진행률(20/40/60/80/100%) 판정, 중단시 취소
#   - completeJobChange() 가 02_titles.sk 의 grantTitle() 호출
#   - skills.sk 가 이 파일의 jobdata::skills 목록을 참조해 스킬 슬롯 자동배정/해금을 처리
########################################################################

function registerJobSkill(job: text, skillname: text, level: number, passive: boolean):
	add {_skillname} to {jobdata::skills::%{_job}%::*}
	set {jobdata::skillreq::%{_skillname}%} to {_level}
	set {jobdata::skillowner::%{_skillname}%} to {_job}
	set {jobdata::skillpassive::%{_skillname}%} to {_passive}

function registerJob(job: text, hidden: boolean, type: text, tool: text):
	add {_job} to {jobdata::list::*}
	set {jobdata::hidden::%{_job}%} to {_hidden}
	set {jobdata::type::%{_job}%} to {_type}
	set {jobtooldata::%{_job}%} to {_tool}

on script load:
	delete {jobdata::list::*}

	registerJob("검사(서양)", false, "전투", "")
	registerJobSkill("검사(서양)", "패링", 1, false)
	registerJobSkill("검사(서양)", "가르기", 10, false)
	registerJobSkill("검사(서양)", "오러", 20, true)
	registerJobSkill("검사(서양)", "스턴패링", 35, false)
	registerJobSkill("검사(서양)", "마나블레이드", 50, false)

	registerJob("검사(동양)", false, "전투", "")
	registerJobSkill("검사(동양)", "패링", 1, false)
	registerJobSkill("검사(동양)", "검기", 10, false)
	registerJobSkill("검사(동양)", "기", 20, true)
	registerJobSkill("검사(동양)", "카운터", 30, false)
	registerJobSkill("검사(동양)", "스텝", 40, true)
	registerJobSkill("검사(동양)", "섬멸", 50, false)

	registerJob("마법사", false, "원거리 전투·극딜", "마법지팡이")
	registerJobSkill("마법사", "마나볼", 1, false)
	registerJobSkill("마법사", "파이어볼", 10, false)
	registerJobSkill("마법사", "마나쉴드", 20, true)
	registerJobSkill("마법사", "일렉트릭", 30, false)
	registerJobSkill("마법사", "블리자드볼", 40, false)
	registerJobSkill("마법사", "마나브레스", 50, false)

	registerJob("궁수", false, "후방견제·극딜", "무한 활")
	registerJobSkill("궁수", "숙련된 궁술실력", 1, true)
	registerJobSkill("궁수", "파워샷", 10, false)
	registerJobSkill("궁수", "레인애로우", 20, false)
	registerJobSkill("궁수", "파이어애로우", 30, false)
	registerJobSkill("궁수", "속사", 40, false)
	registerJobSkill("궁수", "피날레", 50, false)

	registerJob("힐러", false, "보조·언데드 제거", "")
	registerJobSkill("힐러", "빠른 재생", 1, true)
	registerJobSkill("힐러", "힐", 10, false)
	registerJobSkill("힐러", "그레이트힐", 20, false)
	registerJobSkill("힐러", "영역힐", 30, false)
	registerJobSkill("힐러", "성스러운심판", 40, false)
	registerJobSkill("힐러", "절대영역힐", 50, false)

	registerJob("탱커", false, "탱커·어그로 관리", "")
