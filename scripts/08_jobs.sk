	broadcast "<gray>[시스템] 직업 데이터 %size of {jobdata::list::*}%종 로드 완료" to console

# ------------------------------------------------------------------
# /전직장소 <직업이름> 등록 (03_biomes.sk 명령에서 호출)
# ------------------------------------------------------------------
function registerJobLocation(p: player, job: text, loc: location):
	if {_job} is not in {jobdata::list::*}:
		send "<red>존재하지 않는 직업입니다: %{_job}%" to {_p}
		stop
	set {joblocation::%{_job}%::world} to "%world of {_loc}%"
	set {joblocation::%{_job}%::x} to x of {_loc}
	set {joblocation::%{_job}%::y} to y of {_loc}
	set {joblocation::%{_job}%::z} to z of {_loc}
	send "<green>[전직장소] %{_job}% 전직 장소가 현재 위치로 등록되었습니다." to {_p}

function nearestJobLocation(p: player) :: text:
	loop {jobdata::list::*}:
		if {joblocation::%loop-value%::world} is set:
			if {joblocation::%loop-value%::world} is "%world of {_p}%":
				set {_dx} to x of location of {_p} - {joblocation::%loop-value%::x}
				set {_dy} to y of location of {_p} - {joblocation::%loop-value%::y}
				set {_dz} to z of location of {_p} - {joblocation::%loop-value%::z}
				set {_dist} to sqrt(({_dx} * {_dx}) + ({_dy} * {_dy}) + ({_dz} * {_dz}))
				if {_dist} <= 3:
					return loop-value
	return ""

every 1 second:
	loop all players:
		set {_p} to loop-player
		set {_near} to nearestJobLocation({_p})
		if {_near} is not "" and {_p} is sneaking:
			if {jobchange::%{_p}%::target} is not {_near}:
				set {jobchange::%{_p}%::target} to {_near}
				set {jobchange::%{_p}%::progress} to 0
			add 1 to {jobchange::%{_p}%::progress}
			set {_pct} to {jobchange::%{_p}%::progress} * 20
			send action bar "<yellow>[%{_near}%] 전직 진행중: <gold>%{_pct}%%%" to {_p}
			if {jobchange::%{_p}%::progress} >= 5:
				completeJobChange({_p}, {_near})
				delete {jobchange::%{_p}%::progress}
				delete {jobchange::%{_p}%::target}
		else:
			if ({jobchange::%{_p}%::progress} ? 0) > 0:
				send action bar "<red>전직이 취소되었습니다." to {_p}
			delete {jobchange::%{_p}%::progress}
			delete {jobchange::%{_p}%::target}

function completeJobChange(p: player, job: text):
	if {stats::%{_p}%::job} is {_job}:
		send "<red>이미 %{_job}% 직업입니다." to {_p}
		stop
	if {jobdata::hidden::%{_job}%} is true:
		if {server::hiddenjob::%{_job}%} is set and {server::hiddenjob::%{_job}%} is not "%{_p}%":
			send "<red>[히든 직업] %{_job}%은(는) 이미 다른 유저가 차지하고 있습니다." to {_p}
			stop
		set {server::hiddenjob::%{_job}%} to "%{_p}%"
		if {server::anyhiddenjobclaimed} is not true:
			set {server::anyhiddenjobclaimed} to true
			grantTitle({_p}, "유일무이")
			broadcast "<gold>[서버 최초] %{_p}%님이 서버 최초로 히든 직업(%{_job}%)을 차지했습니다!"

	# 기존 히든 직업 보유였다면 슬롯 반납
	set {_oldjob} to {stats::%{_p}%::job}
	if {_oldjob} is not "" and {jobdata::hidden::%{_oldjob}%} is true:
		if {server::hiddenjob::%{_oldjob}%} is "%{_p}%":
			delete {server::hiddenjob::%{_oldjob}%}

	set {stats::%{_p}%::job} to {_job}
	resetSkillSlots({_p})
	giveJobTool({_p}, {_job})
	send "<gold><bold>[전직 완료]<reset> <yellow>%{_p}%<reset>님이 <aqua>%{_job}%<reset> 직업을 얻었습니다!" to all players
	play sound "entity.player.levelup" at {_p} with volume 1 for {_p}

	grantTitle({_p}, "전직자")
	if {_job} is "검사(서양)" or {_job} is "검사(동양)":
		grantTitle({_p}, "검의 길")
	else if {_job} is "마법사":
		grantTitle({_p}, "마나의 흐름")
	else if {_job} is "궁수":
		grantTitle({_p}, "활의 명수")
	else if {_job} is "힐러":
		grantTitle({_p}, "생명의 손길")
	else if {_job} is "탱커":
		grantTitle({_p}, "불굴의 방패")
	if {jobdata::hidden::%{_job}%} is true:
		grantTitle({_p}, "숨겨진 힘")

function giveJobTool(p: player, job: text):
	set {_tool} to {jobtooldata::%{_job}%}
	if {_tool} is "마법지팡이":
		give {_p} a blaze rod named "<light_purple>마법지팡이" with lore "<gray>마법사 전용 무기"
	else if {_tool} is "무한 활":
		give {_p} a bow named "<green>무한 활" with lore "<gray>궁수 전용 무기 (화살 소모 없음)"
		give {_p} 10 of arrow
	else if {_tool} is "돋보기":
		give {_p} a spyglass named "<yellow>돋보기" with lore "<gray>고고학자 전용 도구"
	else if {_tool} is "모방점토":
		give {_p} a clay ball named "<aqua>모방점토" with lore "<gray>모방자 전용 재료"

command /직업정보:
	trigger:
		set {_job} to {stats::%player%::job}
		if {_job} is "" or {_job} is not set:
			send "<gray>아직 직업이 없습니다. 전직 장소에서 5초간 웅크려 전직하세요." to player
			stop
		send "<gold>=== 직업 정보 ===" to player
		send "<yellow>직업: <white>%{_job}%<gray> (%{jobdata::type::%{_job}%}%)" to player
		loop {jobdata::skills::%{_job}%::*}:
			set {_req} to {jobdata::skillreq::%loop-value%}
			set {_have} to ({stats::%player%::level} ? 1) >= {_req}
			if {_have} is true:
				send "<green>✔ %loop-value% <gray>(%{_req}%Lv)" to player
			else:
				send "<dark_gray>✘ %loop-value% (%{_req}%Lv)" to player
