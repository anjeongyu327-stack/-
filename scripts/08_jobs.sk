	registerJobSkill("탱커", "피해감소", 10, true)
	registerJobSkill("탱커", "더욱더 단단함", 20, true)
	registerJobSkill("탱커", "성벽", 30, false)
	registerJobSkill("탱커", "돌진", 40, false)
	registerJobSkill("탱커", "자폭", 50, false)

	registerJob("마검사", true, "전투·디버프", "")
