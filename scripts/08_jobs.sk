	registerJobSkill("마검사", "일렉트릭소드", 10, false)
	registerJobSkill("마검사", "브레이크소드", 15, false)
	registerJobSkill("마검사", "스타소드", 30, false)
	registerJobSkill("마검사", "성군베기", 40, false)
	registerJobSkill("마검사", "헬파이어소드", 50, false)

	registerJob("고고학자", true, "탐색·전투·서브", "돋보기")
